# ==========================================================
#  Скопируйте этот файл в .env и заполните своими значениями
#  cp .env.example .env   (Linux/Mac)
#  copy .env.example .env (Windows)
# ==========================================================

# --- Telegram ---
# Токен бота от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Ваш личный Telegram ID (узнать можно у @userinfobot).
# Именно сюда бот будет присылать объявления, и только вы сможете им управлять.
ADMIN_ID=123456789

# --- Парсинг ---
# Интервал запуска парсинга (в минутах). Реальный интервал будет случайным
# в диапазоне [MIN; MAX], чтобы поведение было менее «роботным».
PARSE_INTERVAL_MIN=7
PARSE_INTERVAL_MAX=10

# Сколько объявлений максимум брать с одного сайта за один проход
MAX_ADS_PER_SITE=30

# --- База данных ---
# Путь к файлу SQLite (по умолчанию ads.db рядом с проектом)
# DB_PATH=ads.db

# --- Включение/выключение отдельных сайтов (1 = вкл, 0 = выкл) ---
SITE_AVITO=1
SITE_YOUDO=1
SITE_FLRU=1
SITE_KWORK=1
SITE_HH=1

# --- Задержки между запросами (секунды), чтобы не попасть под бан ---
REQUEST_DELAY_MIN=1.0
REQUEST_DELAY_MAX=3.0

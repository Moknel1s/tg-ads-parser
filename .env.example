# ==========================================================
#  Скопируйте этот файл в .env и заполните своими значениями
#  cp .env.example .env   (Linux/Mac)
#  copy .env.example .env (Windows)
# ==========================================================

# --- Telegram ---
# Токен бота от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Куда бот присылает найденные объявления.
# Это может быть:
#   - ваш личный Telegram ID (узнать у @userinfobot), например 123456789
#   - ID группы/канала (у групп он отрицательный), например -5542159787
# Если шлёте в группу — обязательно добавьте бота в эту группу!
TARGET_CHAT_ID=123456789

# Кто может управлять ботом (командами /status, /parse_now и т.д.).
# Список ЛИЧНЫХ ID людей через запятую (положительные, не ID группы!).
# Пример для двух человек:  ADMIN_IDS=123456789, 222333444
ADMIN_IDS=123456789

# (Необязательно) отдельный чат для объявлений КОНКРЕТНОЙ страны.
# Формат TARGET_CHAT_<КОД>: RU, UZ, UA, US, GB, AU. Если не задано — общий чат.
# Пример: объявления из Украины — в отдельный чат:
# TARGET_CHAT_UA=6559307546

# --- Парсинг ---
# Интервал запуска парсинга (в минутах). Реальный интервал будет случайным
# в диапазоне [MIN; MAX], чтобы поведение было менее «роботным».
PARSE_INTERVAL_MIN=7
PARSE_INTERVAL_MAX=10

# Сколько объявлений максимум брать с одного сайта за один проход
MAX_ADS_PER_SITE=30

# --- База данных ---
# Путь к файлу SQLite (по умолчанию ads.db рядом с проектом)
# DB_PATH=ads.db

# --- Включение/выключение целых СТРАН (1 = вкл, 0 = выкл) ---
COUNTRY_RU=1
COUNTRY_UZ=1
COUNTRY_US=1
COUNTRY_GB=1
COUNTRY_AU=1

# --- Включение/выключение отдельных САЙТОВ (переопределяет значение по умолч.) ---
# Формат: SITE_<КЛЮЧ>=1|0. Ключи смотрите в /sites.
# По умолчанию включены рабочие без авторизации:
#   RU: hh, kwork, flru, youdo, freelanceru, weblancer, habr
#   UZ: olxuz
#   US: reddit, craigslist
# Остальные выключены — им нужны ключи API / прокси / проверка селекторов.
# Примеры:
# SITE_AVITO=1          # включить Avito (нужен playwright/прокси)
# SITE_UPWORK=1         # включить Upwork (нужен вход/API)
# SITE_KWORK=0          # выключить Kwork

# --- Задержки между запросами (секунды), чтобы не попасть под бан ---
REQUEST_DELAY_MIN=1.0
REQUEST_DELAY_MAX=3.0

# --- Прокси (для обхода антибота / гео-блокировок) ---
# Применяется и к обычным запросам, и к playwright. Пусто = без прокси.
# Рекомендуется РЕЗИДЕНТНЫЙ прокси нужной страны (UZ/RU).
# Примеры:
# PROXY_URL=http://185.12.34.56:8000
# PROXY_URL=http://login:password@proxy.example.com:8080
# PROXY_URL=socks5://login:password@1.2.3.4:1080
PROXY_URL=

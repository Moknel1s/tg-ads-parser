@echo off
chcp 65001 >nul
REM Запуск Telegram-бота одним кликом.
REM Переходим в папку, где лежит этот файл, и запускаем бота из venv.
cd /d "%~dp0"
".venv\Scripts\python.exe" main.py
REM Если бот упадёт или вы его остановите — окно не закроется сразу,
REM чтобы вы успели прочитать сообщение.
pause
